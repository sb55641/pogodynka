{% autoescape false %}
{
    "country": "{{ country }}",
    "city": "{{ city }}",
    "measurements": [
        {% for m in measurements %}
        {
            "date": "{{ m.date|date('Y-m-d') }}",
            "celsius": "{{ m.tempCelsius }}",
            "feels_like": "{{ m.feelsLikeCelsius }}",
            "condition": "{{ m.weatherCondition }}",
            "fahrenheit": "{{ m.fahrenheit }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
{% endautoescape %}
